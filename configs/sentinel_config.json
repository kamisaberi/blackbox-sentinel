{
  "appliance": {
    "node_id": "sentinel-alpha-01",
    "facility_name": "DataCenter-Zone-A",
    "http_port": 8443,
    "websocket_port": 8444,
    "enable_tls": false
  },
  "ai_engine": {
    "xinfer_target": "OpenVINO",
    "model_path": "models/version-RFB-320.onnx",
    "input_tensor_name": "input",
    "output_tensor_name": "scores",
    "anomaly_threshold": 0.85
  },
  "ingestion": {
    "network_interface": "ens33",
    "enable_ebpf_xdp": true,
    "syslog_port": 514
  },
  "mitigation": {
    "auto_block_enabled": true,
    "ebpf_block_duration_sec": 3600
  }
}